---
import { getCollection, render } from 'astro:content';
import EventLayout from '../../../layouts/Event.astro';
import { getEntryForLang, parseEntryId } from '../../../i18n/utils';

export async function getStaticPaths() {
  const events = await getCollection('events');
  const uniqueBaseIds = Array.from(
    new Set(events.map((e) => parseEntryId(e.id).baseId))
  );

  return uniqueBaseIds.map((baseId) => {
    const event = getEntryForLang(events, baseId, 'en');
    return {
      params: { id: baseId },
      props: { event },
    };
  });
}

const { event } = Astro.props;
const { Content } = await render(event);
---

<EventLayout event={event}>
  <Content />
</EventLayout>
