---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="About Randonneurs Belarus">
  <Navbar />
  <PageHeader
    title="ABOUT THE COMMUNITY"
    description="The history, mission, and platform driving ultra-distance cycling in Belarus."
  />

  <main class="bg-page-bg flex w-full flex-col items-center">
    <div
      class="text-text flex w-full max-w-[1280px] flex-col items-center gap-[80px] px-[64px] pt-[64px] pb-[80px]"
    >
      {/* Vision */}
      <section class="flex w-full max-w-[1000px] flex-col gap-[32px]">
        <h2
          class="text-text font-heading text-[48px] leading-tight font-bold uppercase"
        >
          IT'S NOT JUST ABOUT THE DISTANCE. IT'S ABOUT DISCOVERING WHAT LIES
          BEYOND IT.
        </h2>
        <p
          class="text-text-muted font-body text-[20px] leading-relaxed font-normal"
        >
          Since our official inception in 2010, the randonneuring community in
          Belarus has grown from a handful of enthusiasts to a nationwide
          network of clubs and independent riders. We are united by the open
          road, the ticking clock, and the pursuit of homologation.
        </p>
      </section>

      {/* Facts */}
      <section class="flex h-[240px] w-full max-w-[1000px] gap-[24px]">
        <div
          class="bg-complementary flex flex-1 flex-col justify-between rounded-tl-[40px] rounded-tr-[0px] rounded-br-[40px] rounded-bl-[40px] p-[40px]"
        >
          <span class="text-brand font-body text-[18px] font-semibold"
            >FIRST OFFICIAL BREVET</span
          >
          <span
            class="text-text font-heading text-[64px] leading-none font-bold"
            >2010</span
          >
        </div>
        <div
          class="bg-brand flex flex-1 flex-col justify-between rounded-tl-[0px] rounded-tr-[40px] rounded-br-[40px] rounded-bl-[40px] p-[40px]"
        >
          <span class="text-page-bg font-body text-[18px] font-semibold"
            >NATIONWIDE CLUBS</span
          >
          <span
            class="text-page-bg font-heading text-[64px] leading-none font-bold"
            >12</span
          >
        </div>
        <div
          class="bg-accent flex flex-1 flex-col justify-between rounded-tl-[40px] rounded-tr-[40px] rounded-br-[0px] rounded-bl-[40px] p-[40px]"
        >
          <span class="text-page-bg font-body text-[18px] font-semibold"
            >ROUTES CREATED</span
          >
          <span
            class="text-page-bg font-heading text-[64px] leading-none font-bold"
            >150+</span
          >
        </div>
      </section>

      {/* History */}
      <section
        class="flex w-full max-w-[1000px] flex-col gap-[64px] lg:flex-row"
      >
        <div class="flex flex-1 flex-col gap-[32px]">
          <h3 class="text-text font-heading text-[32px] font-bold uppercase">
            HOW IT ALL STARTED
          </h3>
          <p
            class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
          >
            Before GPS head units, smartwatches, and ultra-light bikepacking
            gear, there were just riders with printed cue sheets and a desire to
            see how far they could go in a single day. The early brevets were
            gritty, self-organized rides. Today, we maintain that same spirit of
            adventure while bringing structure, official ACP recognition, and
            modern digital tools to the experience.
          </p>
          <div
            class="border-accent flex flex-col gap-[16px] border bg-transparent p-[32px]"
          >
            <p
              class="text-accent font-body text-[24px] leading-relaxed font-semibold italic"
            >
              "We didn't ride to win. We rode to prove that the human machine is
              capable of extraordinary things."
            </p>
          </div>
        </div>
        <div class="h-[400px] w-[400px] shrink-0">
          <img
            src="https://images.unsplash.com/photo-1517649763962-0c623066013b?q=80&w=800&auto=format&fit=crop"
            class="h-full w-full rounded-tr-[80px] object-cover"
            alt="Historical riding photo"
          />
        </div>
      </section>

      {/* Mission */}
      <section class="flex w-full max-w-[1000px] flex-col gap-[40px]">
        <h3 class="text-text font-heading text-[32px] font-bold uppercase">
          THE SPIRIT OF RANDONNEURING
        </h3>
        <div class="flex w-full flex-col gap-[32px] md:flex-row">
          <div class="flex flex-1 flex-col gap-[16px]">
            <span
              class="text-text-muted font-heading text-[48px] leading-none font-bold"
              >01</span
            >
            <h4
              class="text-text font-heading text-[20px] font-semibold uppercase"
            >
              Radical Self-Sufficiency
            </h4>
            <p
              class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
            >
              No team cars. No sag wagons. Just you, your bike, and your
              preparation. You are responsible for navigating, pacing, and
              troubleshooting your way to the finish line.
            </p>
          </div>
          <div class="flex flex-1 flex-col gap-[16px]">
            <span
              class="text-text-muted font-heading text-[48px] leading-none font-bold"
              >02</span
            >
            <h4
              class="text-text font-heading text-[20px] font-semibold uppercase"
            >
              Relentless Endurance
            </h4>
            <p
              class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
            >
              Pushing past the physical and mental limits to achieve distances
              that seem impossible. It's not a race against others, but a test
              against the clock and yourself.
            </p>
          </div>
          <div class="flex flex-1 flex-col gap-[16px]">
            <span
              class="text-text-muted font-heading text-[48px] leading-none font-bold"
              >03</span
            >
            <h4
              class="text-text font-heading text-[20px] font-semibold uppercase"
            >
              Unbreakable Camaraderie
            </h4>
            <p
              class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
            >
              We ride alone, but we finish together. Helping a fellow rider fix
              a flat or offering a wheel to draft on a windy stretch is the
              hallmark of a true randonneur.
            </p>
          </div>
        </div>
      </section>

      {/* Changelog */}
      <section class="flex w-full max-w-[1000px] flex-col gap-[48px]">
        <h3 class="text-text font-heading text-[32px] font-bold uppercase">
          PLATFORM EVOLUTION
        </h3>

        <div class="flex w-full flex-col">
          <div class="flex w-full flex-col gap-[32px] pb-[32px] md:flex-row">
            <div class="flex w-[200px] shrink-0 flex-col gap-[8px]">
              <span class="text-text font-body text-[16px] font-bold"
                >October 2026</span
              >
              <div
                class="bg-brand/10 border-brand w-fit rounded-[16px] border px-[8px] py-[4px]"
              >
                <span
                  class="text-brand font-body text-[10px] font-bold uppercase"
                  >FEATURE</span
                >
              </div>
            </div>
            <div class="flex flex-1 flex-col gap-[16px]">
              <h4
                class="text-text font-heading text-[24px] leading-tight font-bold"
              >
                New Route Builder Tool
              </h4>
              <p
                class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
              >
                We have released a new interactive route builder tool that
                integrates with the official ACP rules engine, warning
                organizers of rule violations before homologation submission.
              </p>
            </div>
          </div>

          <div
            class="border-surface flex w-full flex-col gap-[32px] border-t py-[32px] md:flex-row"
          >
            <div class="flex w-[200px] shrink-0 flex-col gap-[8px]">
              <span class="text-text font-body text-[16px] font-bold"
                >August 2026</span
              >
              <div
                class="bg-accent/10 border-accent w-fit rounded-[16px] border px-[8px] py-[4px]"
              >
                <span
                  class="text-accent font-body text-[10px] font-bold uppercase"
                  >UPDATE</span
                >
              </div>
            </div>
            <div class="flex flex-1 flex-col gap-[16px]">
              <h4
                class="text-text font-heading text-[24px] leading-tight font-bold"
              >
                Digital Brevet Cards
              </h4>
              <p
                class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
              >
                Say goodbye to paper! Participants can now use our mobile PWA to
                digitally check-in at controls. The times are synced directly
                with the central tracker.
              </p>
            </div>
          </div>

          <div
            class="border-surface flex w-full flex-col gap-[32px] border-t py-[32px] md:flex-row"
          >
            <div class="flex w-[200px] shrink-0 flex-col gap-[8px]">
              <span class="text-text font-body text-[16px] font-bold"
                >May 2026</span
              >
              <div
                class="bg-brand/10 border-brand w-fit rounded-[16px] border px-[8px] py-[4px]"
              >
                <span
                  class="text-brand font-body text-[10px] font-bold uppercase"
                  >RELEASE</span
                >
              </div>
            </div>
            <div class="flex flex-1 flex-col gap-[16px]">
              <h4
                class="text-text font-heading text-[24px] leading-tight font-bold"
              >
                Community Platform Launch
              </h4>
              <p
                class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
              >
                The biggest update this year brings rider profiles, club pages,
                and a unified calendar tracking every single brevet happening
                across Belarus.
              </p>
            </div>
          </div>
        </div>

        <p class="text-text-muted font-body text-[16px] font-normal">
          While our core is riding, our backbone is the technical
          infrastructure. This open-source platform is continuously evolving to
          support the needs of organizers and participants alike. Follow our
          GitHub repository to see what's next.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
