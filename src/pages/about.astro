---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <Navbar />

  <PageHeader
    title="ABOUT THE PROJECT"
    description="Our mission, history, and the spirit of randonneuring."
  />

  <section class="bg-page-bg py-16 lg:py-20">
    <div
      class="mx-auto flex max-w-[1000px] flex-col gap-20 px-4 sm:px-8 lg:px-16"
    >
      <!-- Vision -->
      <div class="flex flex-col gap-8">
        <h2
          class="font-heading text-text text-3xl leading-tight font-bold uppercase lg:text-4xl"
        >
          CYCLING IS NOT JUST ABOUT THE BIKE. IT'S ABOUT THE JOURNEY, THE
          PEOPLE, AND THE RELENTLESS WILL TO KEEP PEDALING.
        </h2>
        <p class="font-body text-text-muted text-xl leading-relaxed">
          Founded in 2010, Randonneurs Belarus started with a simple idea: to
          bring the rich French tradition of Audax Club Parisien to the
          sprawling, beautiful roads of our homeland. What began with a handful
          of enthusiasts has grown into a nationwide movement.
        </p>
      </div>

      <!-- Facts Grid -->
      <div class="grid min-h-[240px] grid-cols-1 gap-6 md:grid-cols-3">
        <div
          class="bg-surface flex flex-col justify-between rounded-tl-[40px] rounded-br-[40px] rounded-bl-[40px] p-10"
        >
          <span
            class="font-heading text-text-muted text-lg font-semibold uppercase"
            >ESTABLISHED</span
          >
          <span class="font-heading text-text text-4xl font-bold">2010</span>
        </div>
        <div
          class="bg-surface flex flex-col justify-between rounded-tr-[40px] rounded-br-[40px] rounded-bl-[40px] p-10"
        >
          <span
            class="font-heading text-text-muted text-lg font-semibold uppercase"
            >ACTIVE CLUBS</span
          >
          <span class="font-heading text-text text-4xl font-bold">12</span>
        </div>
        <div
          class="bg-surface flex flex-col justify-between rounded-tl-[40px] rounded-tr-[40px] rounded-bl-[40px] p-10"
        >
          <span
            class="font-heading text-text-muted text-lg font-semibold uppercase"
            >BREVETS HELD</span
          >
          <span class="font-heading text-text text-4xl font-bold">150+</span>
        </div>
      </div>

      <!-- History -->
      <div class="flex flex-col items-start gap-16 md:flex-row">
        <div class="flex flex-1 flex-col gap-8">
          <h3 class="font-heading text-text text-3xl font-bold uppercase">
            THE EARLY DAYS
          </h3>
          <p class="font-body text-text-muted text-base leading-relaxed">
            Before GPS head units and ultra-light bikepacking gear, completing a
            200km brevet required a paper cue sheet, a reliable dynamo, and
            immense grit. Our first official brevet saw only 8 finishers,
            battling headwinds and gravel roads. It wasn't about speed; it was
            about survival and camaraderie.
          </p>
          <div class="border-accent border-l-4 py-4 pl-8">
            <p
              class="font-heading text-accent text-2xl leading-snug font-semibold italic"
            >
              "We didn't ride to win. We rode to prove that the human body can
              outlast the setting sun."
            </p>
          </div>
        </div>
        <div
          class="h-[400px] w-full shrink-0 overflow-hidden rounded-tr-[80px] bg-gray-200 md:w-[400px]"
        >
          <!-- Using a generic placeholder image since the design file references an auto-generated one -->
          <img
            src="https://images.unsplash.com/photo-1541625602330-2277a4c4618c?q=80&w=800&auto=format&fit=crop"
            alt="Early randonneuring days"
            class="h-full w-full object-cover grayscale"
          />
        </div>
      </div>

      <!-- Core Values -->
      <div class="flex flex-col gap-10">
        <h3 class="font-heading text-text text-3xl font-bold uppercase">
          OUR CORE VALUES
        </h3>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <div class="flex flex-col gap-4">
            <span class="font-heading text-text-muted text-4xl font-bold"
              >01</span
            >
            <h4 class="font-heading text-text text-xl font-semibold">
              Self-Sufficiency
            </h4>
            <p class="font-body text-text-muted text-base leading-relaxed">
              No team cars. No sag wagons. Just you, your bike, and what you can
              carry.
            </p>
          </div>
          <div class="flex flex-col gap-4">
            <span class="font-heading text-text-muted text-4xl font-bold"
              >02</span
            >
            <h4 class="font-heading text-text text-xl font-semibold">
              Endurance
            </h4>
            <p class="font-body text-text-muted text-base leading-relaxed">
              Pushing past the physical and mental limits to achieve distances
              previously thought impossible.
            </p>
          </div>
          <div class="flex flex-col gap-4">
            <span class="font-heading text-text-muted text-4xl font-bold"
              >03</span
            >
            <h4 class="font-heading text-text text-xl font-semibold">
              Camaraderie
            </h4>
            <p class="font-body text-text-muted text-base leading-relaxed">
              We ride alone, but we finish together. Helping a fellow rider is
              always prioritized over finishing time.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
