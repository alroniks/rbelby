---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import {
  getLangFromUrl,
  useTranslatedPath,
  getLocalizedCollection,
} from '../../i18n/utils';
import Icon from '../../components/Icon.astro';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const allRoutes = await getCollection('routes');
const localizedRoutes = getLocalizedCollection(allRoutes, lang);

const routes = localizedRoutes.map((route) => {
  return {
    ...route,
    dist: route.data.distance,
    start: route.data.startLocation || 'Unknown',
    type: route.data.type || '100% Paved',
    // Fallbacks for data not in schema yet
    status: (route.data as any).status || 'OFFICIAL',
    elevation: (route.data as any).elevation || 0,
  };
});

// Sort by distance (short to long)
routes.sort((a, b) => a.dist - b.dist);
---

<Layout title="Routes Archive">
  <Navbar />
  <PageHeader
    title="ROUTES ARCHIVE"
    description="Explore our library of classic brevets and permanent routes."
  />

  <main class="bg-bg text-text min-h-screen pb-20">
    <div
      class="mx-auto mt-12 flex max-w-7xl flex-col items-start gap-12 px-4 sm:px-8 lg:flex-row lg:px-16"
    >
      <!-- Main Content -->
      <div class="flex w-full min-w-0 flex-1 flex-col gap-8">
        <!-- Controls Header -->
        <div
          class="bg-surface border-gray flex flex-col items-start justify-between gap-4 rounded-xl border p-4 sm:flex-row sm:items-center"
        >
          <span class="text-text-muted font-medium"
            >Showing <span id="route-count" class="text-text font-bold"
              >{routes.length}</span
            > selected routes</span
          >
          <div class="flex items-center gap-3">
            <span
              class="text-text-muted text-xs font-bold tracking-widest uppercase"
              >SORT BY</span
            >
            <div class="relative">
              <select
                class="bg-bg border-gray focus:ring-primary appearance-none rounded-lg border py-2 pr-10 pl-4 text-sm font-bold focus:ring-2 focus:outline-none"
              >
                <option value="dist-asc">Distance (Short to Long)</option>
                <option value="dist-desc">Distance (Long to Short)</option>
                <option value="name">Name (A-Z)</option>
              </select>
              <div
                class="text-text-muted pointer-events-none absolute inset-y-0 right-0 flex items-center px-3"
              >
                <Icon name="ChevronDown" class="size-4" />
              </div>
            </div>
          </div>
        </div>

        <!-- Routes Grid -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2" id="routes-grid">
          {
            routes.map((route) => (
              <article
                class="route-card bg-surface border-gray group flex flex-col overflow-hidden rounded-3xl border transition-shadow hover:shadow-md"
                data-dist={route.dist}
                data-type={route.type}
                data-status={route.status}
                data-name={route.data.name.toLowerCase()}
              >
                {/* Thumbnail */}
                <div class="bg-gray/30 relative h-48 overflow-hidden">
                  <img
                    src={
                      route.data.ogImage ||
                      'https://images.unsplash.com/photo-1558981403-c5f9899a28bc?q=80&w=800&auto=format&fit=crop'
                    }
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    alt=""
                  />
                  <div class="absolute top-4 left-4 flex gap-2">
                    <span class="bg-bg/90 text-text rounded-full px-3 py-1 text-xs font-bold tracking-wider uppercase backdrop-blur">
                      {route.type}
                    </span>
                    <span class="bg-primary text-text-inverse rounded-full px-3 py-1 text-xs font-bold tracking-wider uppercase">
                      {route.status}
                    </span>
                  </div>
                </div>

                {/* Details */}
                <div class="flex flex-col gap-4 p-6">
                  <div class="flex flex-col gap-1">
                    <a
                      href={translatePath(`/routes/${route.id}`)}
                      class="hover:text-primary transition-colors"
                    >
                      <h3 class="font-heading text-2xl font-bold">
                        {route.data.name}
                      </h3>
                    </a>
                    <span class="text-text-muted text-sm font-medium">
                      Starts in {route.start}
                    </span>
                  </div>

                  <div class="border-gray mt-2 flex items-center gap-6 border-t pt-4">
                    <div class="flex flex-col">
                      <span class="text-text-muted text-xs font-bold tracking-widest uppercase">
                        Distance
                      </span>
                      <span class="font-heading text-xl font-bold">
                        {route.dist} KM
                      </span>
                    </div>
                    <div class="flex flex-col">
                      <span class="text-text-muted text-xs font-bold tracking-widest uppercase">
                        Elevation
                      </span>
                      <span class="font-heading text-xl font-bold">
                        {route.elevation} m
                      </span>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }

          {
            routes.length === 0 && (
              <div class="col-span-full py-20 text-center">
                <h3 class="font-heading text-text mb-2 text-2xl font-bold">
                  No routes found
                </h3>
                <p class="text-text-muted">
                  There are no routes matching your filters.
                </p>
              </div>
            )
          }
        </div>
      </div>

      <!-- Sidebar Filters -->
      <aside class="w-full shrink-0 lg:w-80">
        <div
          class="bg-surface border-gray sticky top-24 flex flex-col gap-8 rounded-3xl border p-8"
        >
          <!-- SearchBox -->
          <div class="relative">
            <div
              class="text-text-muted pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4"
            >
              <Icon name="Search" class="size-5" />
            </div>
            <input
              type="text"
              id="search-input"
              placeholder="Search routes..."
              class="bg-bg border-gray focus:ring-primary placeholder-text-muted w-full rounded-xl border py-3 pr-4 pl-12 font-medium focus:ring-2 focus:outline-none"
            />
          </div>

          <!-- ROUTE STATUS -->
          <div class="flex flex-col gap-3">
            <h4
              class="text-text-muted mb-1 text-xs font-bold tracking-widest uppercase"
            >
              ROUTE STATUS
            </h4>
            <div
              class="filter-group flex flex-col gap-2"
              data-filter-type="status"
            >
              <label
                class="group flex cursor-pointer items-center justify-between"
              >
                <div class="flex items-center gap-3">
                  <input
                    type="radio"
                    name="status"
                    value="all"
                    checked
                    class="peer hidden"
                  />
                  <div
                    class="border-gray peer-checked:bg-primary peer-checked:border-primary flex h-5 w-5 items-center justify-center rounded-md border transition-colors"
                  >
                    <Icon
                      name="Check"
                      class="size-3 text-white opacity-0 peer-checked:opacity-100"
                    />
                  </div>
                  <span
                    class="group-hover:text-primary text-sm font-medium transition-colors"
                    >All Statuses</span
                  >
                </div>
              </label>
              <label
                class="group flex cursor-pointer items-center justify-between"
              >
                <div class="flex items-center gap-3">
                  <input
                    type="radio"
                    name="status"
                    value="OFFICIAL 2026"
                    class="peer hidden"
                  />
                  <div
                    class="border-gray peer-checked:bg-primary peer-checked:border-primary flex h-5 w-5 items-center justify-center rounded-md border transition-colors"
                  >
                    <Icon
                      name="Check"
                      class="size-3 text-white opacity-0 peer-checked:opacity-100"
                    />
                  </div>
                  <span
                    class="group-hover:text-primary text-sm font-medium transition-colors"
                    >Official (Active)</span
                  >
                </div>
              </label>
            </div>
          </div>

          <!-- DISTANCE -->
          <div class="flex flex-col gap-3">
            <h4
              class="text-text-muted mb-1 text-xs font-bold tracking-widest uppercase"
            >
              DISTANCE
            </h4>
            <div
              class="filter-group flex flex-col gap-2"
              data-filter-type="dist"
            >
              <label class="group flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="dist"
                  value="all"
                  checked
                  class="peer hidden"
                />
                <div
                  class="border-gray peer-checked:border-primary h-4 w-4 rounded-full border transition-all peer-checked:border-4"
                >
                </div>
                <span
                  class="group-hover:text-primary text-sm font-medium transition-colors"
                  >All Distances</span
                >
              </label>
              <label class="group flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="dist"
                  value="100"
                  class="peer hidden"
                />
                <div
                  class="border-gray peer-checked:border-primary h-4 w-4 rounded-full border transition-all peer-checked:border-4"
                >
                </div>
                <span
                  class="group-hover:text-primary text-sm font-medium transition-colors"
                  >&lt; 200 km (Populaire)</span
                >
              </label>
              <label class="group flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="dist"
                  value="200"
                  class="peer hidden"
                />
                <div
                  class="border-gray peer-checked:border-primary h-4 w-4 rounded-full border transition-all peer-checked:border-4"
                >
                </div>
                <span
                  class="group-hover:text-primary text-sm font-medium transition-colors"
                  >200 km</span
                >
              </label>
              <label class="group flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="dist"
                  value="300"
                  class="peer hidden"
                />
                <div
                  class="border-gray peer-checked:border-primary h-4 w-4 rounded-full border transition-all peer-checked:border-4"
                >
                </div>
                <span
                  class="group-hover:text-primary text-sm font-medium transition-colors"
                  >300 km</span
                >
              </label>
            </div>
          </div>

          <!-- SURFACE TYPE -->
          <div class="flex flex-col gap-3">
            <h4
              class="text-text-muted mb-1 text-xs font-bold tracking-widest uppercase"
            >
              SURFACE TYPE
            </h4>
            <div
              class="filter-group flex flex-col gap-2"
              data-filter-type="type"
            >
              <label class="group flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="type"
                  value="all"
                  checked
                  class="peer hidden"
                />
                <div
                  class="border-gray peer-checked:border-primary h-4 w-4 rounded-full border transition-all peer-checked:border-4"
                >
                </div>
                <span
                  class="group-hover:text-primary text-sm font-medium transition-colors"
                  >All Surfaces</span
                >
              </label>
              <label class="group flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="type"
                  value="100% Paved"
                  class="peer hidden"
                />
                <div
                  class="border-gray peer-checked:border-primary h-4 w-4 rounded-full border transition-all peer-checked:border-4"
                >
                </div>
                <span
                  class="group-hover:text-primary text-sm font-medium transition-colors"
                  >100% Paved</span
                >
              </label>
              <label class="group flex cursor-pointer items-center gap-3">
                <input
                  type="radio"
                  name="type"
                  value="Mixed Surface"
                  class="peer hidden"
                />
                <div
                  class="border-gray peer-checked:border-primary h-4 w-4 rounded-full border transition-all peer-checked:border-4"
                >
                </div>
                <span
                  class="group-hover:text-primary text-sm font-medium transition-colors"
                  >Mixed Surface</span
                >
              </label>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById(
      'search-input'
    ) as HTMLInputElement;
    const filterGroups = document.querySelectorAll('.filter-group');
    const cards = document.querySelectorAll('.route-card');
    const countDisplay = document.getElementById('route-count');

    function applyFilters() {
      const searchTerm = searchInput.value.toLowerCase();
      const filters: Record<string, string> = {};

      filterGroups.forEach((group) => {
        const type = (group as HTMLElement).dataset.filterType!;
        const checked = group.querySelector(
          'input:checked'
        ) as HTMLInputElement;
        filters[type] = checked ? checked.value : 'all';
      });

      let visibleCount = 0;

      cards.forEach((card) => {
        const c = card as HTMLElement;
        const name = c.dataset.name || '';
        const dist = parseInt(c.dataset.dist || '0');
        const status = c.dataset.status || '';
        const type = c.dataset.type || '';

        let match = true;

        if (searchTerm && !name.includes(searchTerm)) match = false;

        if (filters.status !== 'all' && status !== filters.status)
          match = false;
        if (filters.type !== 'all' && type !== filters.type) match = false;

        if (filters.dist !== 'all') {
          const targetDist = parseInt(filters.dist);
          if (targetDist === 100) {
            if (dist >= 200) match = false; // Populaire
          } else if (dist !== targetDist) {
            match = false;
          }
        }

        if (match) {
          c.style.display = 'flex';
          visibleCount++;
        } else {
          c.style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.textContent = visibleCount.toString();
      }
    }

    searchInput?.addEventListener('input', applyFilters);
    filterGroups.forEach((group) => {
      const inputs = group.querySelectorAll('input');
      inputs.forEach((input) => {
        input.addEventListener('change', applyFilters);
      });
    });
  });
</script>
