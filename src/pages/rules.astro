---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <Navbar />

  <PageHeader
    title="OFFICIAL RULES"
    description="The rules of ACP brevets and our local guidelines."
  />

  <section class="bg-page-bg w-full">
    <div class="mx-auto flex max-w-7xl flex-col gap-16 px-4 py-16 sm:px-8 lg:px-16">
      <!-- Golden Rule -->
      <div
        class="bg-surface flex flex-col items-center gap-8 rounded-[32px] p-8 lg:flex-row lg:items-start lg:p-12"
      >
        <svg
          class="text-brand h-16 w-16 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="M12 8v4"></path>
          <path d="M12 16h.01"></path>
        </svg>
        <div class="flex flex-col gap-2">
          <h2 class="font-heading text-text text-3xl font-bold">
            THE GOLDEN RULE: SELF-SUFFICIENCY
          </h2>
          <p class="font-body text-text-muted text-lg leading-relaxed">
            Brevets are not races. They are tests of endurance, self-reliance,
            and camaraderie. Personal follow cars or outside support are
            strictly prohibited on the route. You must carry what you need, fix
            your own mechanicals, and navigate independently.
          </p>
        </div>
      </div>

      <!-- Standard Distances -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-2">
          <h2 class="font-heading text-text text-3xl font-bold">
            STANDARD DISTANCES & TIME LIMITS
          </h2>
          <p class="font-body text-text-muted text-lg">
            Calculated based on an average minimum overall speed of 15 km/h
            (including stops).
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          <!-- 200 km -->
          <div
            class="bg-bg flex flex-col items-center gap-4 rounded-3xl p-8 text-center"
          >
            <span
              class="font-heading text-brand text-5xl leading-tight font-bold"
              >200</span
            >
            <span class="font-heading text-text-muted text-base font-semibold"
              >KILOMETERS</span
            >
            <div class="bg-brand my-1 h-1 w-10 rounded-sm"></div>
            <span class="font-body text-text text-2xl font-bold">13h 30m</span>
          </div>
          <!-- 300 km -->
          <div
            class="bg-bg flex flex-col items-center gap-4 rounded-3xl p-8 text-center"
          >
            <span
              class="font-heading text-brand text-5xl leading-tight font-bold"
              >300</span
            >
            <span class="font-heading text-text-muted text-base font-semibold"
              >KILOMETERS</span
            >
            <div class="bg-brand my-1 h-1 w-10 rounded-sm"></div>
            <span class="font-body text-text text-2xl font-bold">20h 00m</span>
          </div>
          <!-- 400 km -->
          <div
            class="bg-bg flex flex-col items-center gap-4 rounded-3xl p-8 text-center"
          >
            <span
              class="font-heading text-brand text-5xl leading-tight font-bold"
              >400</span
            >
            <span class="font-heading text-text-muted text-base font-semibold"
              >KILOMETERS</span
            >
            <div class="bg-brand my-1 h-1 w-10 rounded-sm"></div>
            <span class="font-body text-text text-2xl font-bold">27h 00m</span>
          </div>
          <!-- 600 km -->
          <div
            class="bg-bg flex flex-col items-center gap-4 rounded-3xl p-8 text-center"
          >
            <span
              class="font-heading text-brand text-5xl leading-tight font-bold"
              >600</span
            >
            <span class="font-heading text-text-muted text-base font-semibold"
              >KILOMETERS</span
            >
            <div class="bg-brand my-1 h-1 w-10 rounded-sm"></div>
            <span class="font-body text-text text-2xl font-bold">40h 00m</span>
          </div>
        </div>
      </div>

      <!-- Super Randonneur Card -->
      <div
        class="bg-surface flex flex-col items-center gap-8 rounded-[32px] p-8 lg:flex-row lg:items-start lg:p-10"
      >
        <svg
          class="text-accent h-16 w-16 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="8" r="7"></circle>
          <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
        </svg>
        <div class="flex flex-col gap-2">
          <h2 class="font-heading text-text text-2xl font-bold">
            THE SUPER RANDONNEUR SERIES
          </h2>
          <p class="font-body text-text-muted text-base leading-relaxed">
            A "Super Randonneur" is a rider who successfully completes a full
            series of 200, 300, 400, and 600 km brevets within the same calendar
            year. Earning this title is a major milestone and serves as the
            mandatory qualification to ride extreme distances like 1000km,
            1200km, and the legendary Paris-Brest-Paris.
          </p>
        </div>
      </div>

      <!-- Grand Randonnees -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-2">
          <h2 class="font-heading text-text text-3xl font-bold">
            GRAND RANDONNÉES
          </h2>
          <p class="font-body text-text-muted text-lg">
            Extreme distances requiring the Super Randonneur qualification and
            strategic sleep planning.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          <!-- 1000 km -->
          <div
            class="bg-bg flex flex-col items-center gap-4 rounded-3xl p-8 text-center"
          >
            <span
              class="font-heading text-brand text-5xl leading-tight font-bold"
              >1000</span
            >
            <span class="font-heading text-text-muted text-base font-semibold"
              >KILOMETERS</span
            >
            <div class="bg-brand my-1 h-1 w-10 rounded-sm"></div>
            <span class="font-body text-text text-2xl font-bold">75h 00m</span>
          </div>
          <!-- 1200 km -->
          <div
            class="bg-bg flex flex-col items-center gap-4 rounded-3xl p-8 text-center"
          >
            <span
              class="font-heading text-brand text-5xl leading-tight font-bold"
              >1200</span
            >
            <span class="font-heading text-text-muted text-base font-semibold"
              >KILOMETERS</span
            >
            <div class="bg-brand my-1 h-1 w-10 rounded-sm"></div>
            <span class="font-body text-text text-2xl font-bold">90h 00m</span>
          </div>
        </div>
      </div>

      <!-- CPs and Gear Section -->
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
        <!-- Control Points -->
        <div class="flex flex-col gap-6">
          <h2 class="font-heading text-text text-3xl font-bold">
            CONTROL POINTS (CPs)
          </h2>
          <p class="font-body text-text-muted text-base leading-relaxed">
            To prove you completed the route, you must pass through designated
            control points within specific opening and closing times. At each
            control, you must have your brevet card stamped or provide
            photographic/electronic proof.
          </p>
          <div class="mt-2 flex flex-col gap-4">
            <div class="flex items-center gap-4">
              <svg
                class="text-accent h-6 w-6 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
              <span class="font-body text-text text-base font-semibold"
                >Opening Time: Based on 34 km/h max speed</span
              >
            </div>
            <div class="flex items-center gap-4">
              <svg
                class="text-accent h-6 w-6 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 8 14"></polyline></svg
              >
              <span class="font-body text-text text-base font-semibold"
                >Closing Time: Based on 15 km/h min speed</span
              >
            </div>
          </div>
        </div>

        <!-- Safety Gear -->
        <div class="bg-surface flex flex-col gap-6 rounded-[32px] p-8 lg:p-10">
          <h2 class="font-heading text-text text-3xl font-bold">
            REQUIRED SAFETY GEAR
          </h2>
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-4">
              <svg
                class="text-accent h-6 w-6 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"
                ></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"
                ></path><path d="m17.66 17.66 1.41 1.41"></path><path
                  d="M2 12h2"></path><path d="M20 12h2"></path><path
                  d="m6.34 17.66-1.41 1.41"></path><path
                  d="m19.07 4.93-1.41 1.41"></path></svg
              >
              <span class="font-body text-text text-base font-semibold"
                >Front & Rear Lights (Attached to bike)</span
              >
            </div>
            <div class="flex items-center gap-4">
              <svg
                class="text-accent h-6 w-6 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M20.38 3.46 16 2a24 24 0 0 0-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"
                ></path></svg
              >
              <span class="font-body text-text text-base font-semibold"
                >Reflective Vest/Sash (Worn at night)</span
              >
            </div>
            <div class="flex items-center gap-4">
              <svg
                class="text-accent h-6 w-6 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path></svg
              >
              <span class="font-body text-text text-base font-semibold"
                >Cycling Helmet</span
              >
            </div>
            <div class="flex items-center gap-4">
              <svg
                class="text-accent h-6 w-6 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
                ></path><polyline points="14 2 14 8 20 8"></polyline><line
                  x1="16"
                  y1="13"
                  x2="8"
                  y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
                ></line><line x1="10" y1="9" x2="8" y2="9"></line></svg
              >
              <span class="font-body text-text text-base font-semibold"
                >Brevet Card & ID</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Official Regulations List -->
      <div class="flex flex-col gap-16 py-8 lg:flex-row">
        <div class="flex flex-1 flex-col gap-12">
          <h2 class="font-heading text-text text-3xl font-bold">
            OFFICIAL ACP REGULATIONS
          </h2>

          <div class="flex flex-col gap-4">
            <h3 class="font-heading text-text text-2xl font-bold">
              Article 1: Qualification
            </h3>
            <p class="font-body text-text-muted text-base leading-relaxed">
              These brevets are open to any amateur cyclist regardless of his or
              her cycling affiliations, covered by insurance. Any rider under
              the age of 18 must have consent of his or her parent or legal
              guardian.
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <h3 class="font-heading text-text text-2xl font-bold">
              Article 2: Route Deviations
            </h3>
            <p class="font-body text-text-muted text-base leading-relaxed">
              Each rider must stay on the route. If a rider leaves the route,
              they must return to the route at the same point prior to
              continuing, ie. no shortcuts or detours from the route, unless
              specified by the organizer.
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <h3 class="font-heading text-text text-2xl font-bold">
              Article 3: Homologation
            </h3>
            <p class="font-body text-text-muted text-base leading-relaxed">
              At the finish, the rider must sign his brevet card and return it
              to the organizer. The brevet card will be returned to the rider
              after the brevet has been verified and a homologation number
              issued.
            </p>
          </div>
        </div>

        <!-- Sidebar TOC -->
        <div class="flex w-full shrink-0 flex-col gap-6 lg:w-[300px]">
          <h4 class="font-body text-text-muted text-sm font-bold uppercase">
            OFFICIAL ARTICLES
          </h4>
          <div class="flex flex-col gap-4">
            <a href="#" class="font-body text-text text-base font-semibold"
              >Article 1: Qualification</a
            >
            <a
              href="#"
              class="font-body text-text-muted hover:text-text text-base font-normal transition"
              >Article 2: Deviations</a
            >
            <a
              href="#"
              class="font-body text-text-muted hover:text-text text-base font-normal transition"
              >Article 3: Homologation</a
            >
            <a
              href="#"
              class="font-body text-text-muted hover:text-text text-base font-normal transition"
              >Article 4: Brevet Cards</a
            >
            <a
              href="#"
              class="font-body text-text-muted hover:text-text text-base font-normal transition"
              >Article 5: Abandoning</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
