---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Rules & Regulations">
  <Navbar />
  <PageHeader
    title="RULES & REGULATIONS"
    description="The essential guidelines every randonneur must follow to complete a brevet."
  />

  <main class="bg-page-bg flex w-full flex-col items-center">
    <div
      class="flex w-full max-w-[1280px] flex-col gap-[64px] px-[64px] pt-[64px] pb-[128px] lg:flex-row"
    >
      {/* Rules Wrap */}
      <div class="flex min-w-0 flex-1 flex-col gap-[80px]">
        {/* Golden Rule Block */}
        <section
          class="bg-brand flex w-full items-center gap-[40px] rounded-[24px] p-[48px]"
        >
          <div
            class="bg-complementary flex h-[96px] w-[96px] shrink-0 items-center justify-center rounded-[48px]"
          >
            <Icon name="ShieldAlert" class="text-brand h-[48px] w-[48px]" />
          </div>
          <div class="flex flex-1 flex-col gap-[12px]">
            <h3 class="text-complementary font-heading text-[24px] font-bold">
              THE GOLDEN RULE: SELF-SUFFICIENCY
            </h3>
            <p
              class="font-body text-[16px] leading-relaxed font-normal text-[#ffffff]"
            >
              Brevets are not races. They are tests of endurance, self-reliance,
              and camaraderie. Personal follow cars or outside support are
              strictly prohibited on the route. You must carry what you need,
              fix your own mechanicals, and navigate independently.
            </p>
          </div>
        </section>

        {/* Bottom Split Grid */}
        <div class="flex w-full flex-col gap-[48px] md:flex-row">
          {/* Control Points Column */}
          <section class="flex flex-1 flex-col gap-[24px]">
            <h3 class="text-text font-heading text-[24px] font-bold">
              CONTROL POINTS (CPs)
            </h3>
            <p
              class="text-text-muted font-body text-[14px] leading-relaxed font-normal"
            >
              To prove you completed the route, you must pass through designated
              control points within specific opening and closing times. At each
              control, you must have your brevet card stamped or provide
              photographic/electronic proof.
            </p>
            <div class="flex w-full flex-col gap-[16px]">
              <div
                class="bg-surface flex w-full items-center gap-[16px] rounded-[16px] p-[16px]"
              >
                <Icon
                  name="Clock4"
                  class="text-accent h-[24px] w-[24px] shrink-0"
                />
                <p class="text-text font-body text-[14px] font-semibold">
                  Opening Time: Based on 34 km/h max speed
                </p>
              </div>
              <div
                class="bg-surface flex w-full items-center gap-[16px] rounded-[16px] p-[16px]"
              >
                <Icon
                  name="Clock8"
                  class="text-accent h-[24px] w-[24px] shrink-0"
                />
                <p class="text-text font-body text-[14px] font-semibold">
                  Closing Time: Based on 15 km/h min speed
                </p>
              </div>
            </div>
          </section>

          {/* Safety Gear Column */}
          <section
            class="bg-bg flex flex-1 flex-col gap-[24px] rounded-[24px] p-[32px]"
          >
            <h3 class="text-brand font-heading text-[20px] font-bold">
              REQUIRED SAFETY GEAR
            </h3>
            <div class="flex w-full flex-col gap-[16px]">
              <div class="flex items-center gap-[16px]">
                <Icon
                  name="Sun"
                  class="text-brand h-[20px] w-[20px] shrink-0"
                />
                <span class="text-text font-body text-[14px] font-semibold"
                  >Front &amp; Rear Lights (Attached to bike)</span
                >
              </div>
              <div class="flex items-center gap-[16px]">
                <Icon
                  name="Shirt"
                  class="text-brand h-[20px] w-[20px] shrink-0"
                />
                <span class="text-text font-body text-[14px] font-semibold"
                  >Reflective Vest/Sash (Worn at night)</span
                >
              </div>
              <div class="flex items-center gap-[16px]">
                <Icon
                  name="Shield"
                  class="text-brand h-[20px] w-[20px] shrink-0"
                />
                <span class="text-text font-body text-[14px] font-semibold"
                  >Cycling Helmet</span
                >
              </div>
              <div class="flex items-center gap-[16px]">
                <Icon
                  name="FileText"
                  class="text-brand h-[20px] w-[20px] shrink-0"
                />
                <span class="text-text font-body text-[14px] font-semibold"
                  >Brevet Card &amp; ID</span
                >
              </div>
            </div>
          </section>
        </div>

        {/* Tracking System Explanation */}
        <section class="flex w-full flex-col gap-[32px] p-[48px]">
          <div class="flex flex-col gap-[16px]">
            <h3 class="text-text font-heading text-[24px] font-bold">
              SMS TRACKING SYSTEM
            </h3>
            <p class="text-text-muted font-body text-[16px] font-normal">
              Randonneurs Belarus uses an automated SMS tracking system to
              record your progress and broadcast it to the live tracking page.
            </p>
          </div>
          <div class="flex w-full flex-col gap-[24px] md:flex-row">
            <div class="flex flex-1 flex-col gap-[16px]">
              <div
                class="bg-accent/10 text-accent flex h-[32px] w-[32px] items-center justify-center rounded-full text-[14px] font-bold"
              >
                1
              </div>
              <h4 class="text-text font-heading text-[16px] font-bold">
                Arrive at CP
              </h4>
              <p class="text-text-muted font-body text-[14px] font-normal">
                Reach the designated location.
              </p>
            </div>
            <div class="flex flex-1 flex-col gap-[16px]">
              <div
                class="bg-accent/10 text-accent flex h-[32px] w-[32px] items-center justify-center rounded-full text-[14px] font-bold"
              >
                2
              </div>
              <h4 class="text-text font-heading text-[16px] font-bold">
                Send Code
              </h4>
              <p class="text-text-muted font-body text-[14px] font-normal">
                SMS your unique code to the bot.
              </p>
            </div>
            <div class="flex flex-1 flex-col gap-[16px]">
              <div
                class="bg-accent/10 text-accent flex h-[32px] w-[32px] items-center justify-center rounded-full text-[14px] font-bold"
              >
                3
              </div>
              <h4 class="text-text font-heading text-[16px] font-bold">
                Verify
              </h4>
              <p class="text-text-muted font-body text-[14px] font-normal">
                Get an automated confirmation reply.
              </p>
            </div>
          </div>
          <div
            class="bg-surface/50 border-gray flex w-full items-center gap-[16px] rounded-[16px] border p-[24px]"
          >
            <Icon
              name="MessageSquare"
              class="text-accent h-[24px] w-[24px] shrink-0"
            />
            <p class="text-text font-body text-[14px] font-medium italic">
              Format: Send "CP1" to +375 XX XXX XX XX
            </p>
          </div>
        </section>

        {/* Official Regulations Wrap */}
        <section class="flex w-full flex-col gap-[64px] pt-[48px] pb-[64px]">
          <div class="flex w-full flex-col gap-[36px]">
            <h2 class="text-text font-heading text-[32px] font-bold uppercase">
              OFFICIAL ACP REGULATIONS
            </h2>
            <div class="flex w-full flex-col gap-[32px]">
              <div class="flex w-full flex-col gap-[12px]">
                <h4 class="text-text font-heading text-[20px] font-bold">
                  Article 1: Qualification
                </h4>
                <p
                  class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
                >
                  These brevets are open to any amateur cyclist regardless of
                  his or her cycling affiliations. Any rider under the age of 18
                  must have consent of his or her parent or legal guardian.
                </p>
                <div class="bg-gray mt-[12px] h-[1px] w-full"></div>
              </div>

              <div class="flex w-full flex-col gap-[12px]">
                <h4 class="text-text font-heading text-[20px] font-bold">
                  Article 2: Route Deviations
                </h4>
                <p
                  class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
                >
                  The rider must stay on the route. If a rider leaves the route,
                  they must return to the route at the same point prior to
                  continuing, i.e. no shortcuts or detours from the route are
                  allowed.
                </p>
                <div class="bg-gray mt-[12px] h-[1px] w-full"></div>
              </div>

              <div class="flex w-full flex-col gap-[12px]">
                <h4 class="text-text font-heading text-[20px] font-bold">
                  Article 3: Personal Support
                </h4>
                <p
                  class="text-text-muted font-body text-[16px] leading-relaxed font-normal"
                >
                  Personal support is only allowed at the control points. Any
                  violation of this rule will result in immediate
                  disqualification.
                </p>
                <div class="bg-gray mt-[12px] h-[1px] w-full"></div>
              </div>
            </div>
          </div>
        </section>
      </div>

      {/* Right Sidebar */}
      <aside
        class="sticky top-[100px] flex w-full shrink-0 flex-col gap-[32px] lg:w-[320px]"
      >
        {/* Quick Distances Reminders */}
        <div
          class="bg-bg flex w-full flex-col gap-[16px] rounded-[16px] p-[24px]"
        >
          <h4
            class="text-text font-heading text-[16px] font-bold tracking-widest uppercase"
          >
            TIME LIMITS
          </h4>

          <div class="flex w-full flex-col gap-[12px]">
            <span class="text-brand font-body text-[12px] font-bold"
              >Standard Distances (BRM)</span
            >
            <div class="flex w-full items-center justify-between">
              <span class="text-text font-body text-[14px] font-semibold"
                >200 km</span
              >
              <span class="text-text-muted font-body text-[14px] font-medium"
                >13h 30m</span
              >
            </div>
            <div class="flex w-full items-center justify-between">
              <span class="text-text font-body text-[14px] font-semibold"
                >300 km</span
              >
              <span class="text-text-muted font-body text-[14px] font-medium"
                >20h 00m</span
              >
            </div>
            <div class="flex w-full items-center justify-between">
              <span class="text-text font-body text-[14px] font-semibold"
                >400 km</span
              >
              <span class="text-text-muted font-body text-[14px] font-medium"
                >27h 00m</span
              >
            </div>
            <div class="flex w-full items-center justify-between">
              <span class="text-text font-body text-[14px] font-semibold"
                >600 km</span
              >
              <span class="text-text-muted font-body text-[14px] font-medium"
                >40h 00m</span
              >
            </div>
          </div>

          <div
            class="border-gray flex w-full flex-col gap-[12px] border-t pt-[16px]"
          >
            <span class="text-brand font-body text-[12px] font-bold"
              >Long Distances (LRM)</span
            >
            <div class="flex w-full items-center justify-between">
              <span class="text-text font-body text-[14px] font-semibold"
                >1000 km</span
              >
              <span class="text-text-muted font-body text-[14px] font-medium"
                >75h 00m</span
              >
            </div>
            <div class="flex w-full items-center justify-between">
              <span class="text-text font-body text-[14px] font-semibold"
                >1200 km</span
              >
              <span class="text-text-muted font-body text-[14px] font-medium"
                >90h 00m</span
              >
            </div>
          </div>

          <div class="border-gray w-full border-t pt-[16px]">
            <p class="text-text-muted font-body text-[12px] font-medium italic">
              Exceeding the time limit by even 1 minute results in
              non-homologation.
            </p>
          </div>
        </div>

        {/* Custom ToC */}
        <div
          class="bg-brand border-bg flex w-full flex-col gap-[16px] rounded-[16px] border p-[24px]"
        >
          <h4
            class="text-complementary font-heading text-[16px] font-bold tracking-[1.5px]"
          >
            CONTENTS
          </h4>
          <div class="flex w-full flex-col gap-[12px]">
            <a
              href="#"
              class="text-surface font-body text-[14px] font-semibold transition-colors hover:text-white"
              >The Golden Rule</a
            >
            <a
              href="#"
              class="text-surface font-body text-[14px] font-semibold transition-colors hover:text-white"
              >Control Points (CPs)</a
            >
            <a
              href="#"
              class="text-surface font-body text-[14px] font-semibold transition-colors hover:text-white"
              >Required Safety Gear</a
            >
            <a
              href="#"
              class="text-surface font-body text-[14px] font-semibold transition-colors hover:text-white"
              >Tracking &amp; SMS</a
            >
            <a
              href="#"
              class="text-surface font-body text-[14px] font-semibold transition-colors hover:text-white"
              >Official Regulations</a
            >

            <div class="mt-[4px] flex w-full flex-col gap-[8px] pl-[16px]">
              <a
                href="#"
                class="text-bg font-body text-[13px] font-medium opacity-80 transition-opacity hover:opacity-100"
                >Article 1: Qualification</a
              >
              <a
                href="#"
                class="text-bg font-body text-[13px] font-medium opacity-80 transition-opacity hover:opacity-100"
                >Article 2: Route Deviations</a
              >
              <a
                href="#"
                class="text-bg font-body text-[13px] font-medium opacity-80 transition-opacity hover:opacity-100"
                >Article 3: Personal Support</a
              >
              <a
                href="#"
                class="text-bg font-body text-[13px] font-medium opacity-80 transition-opacity hover:opacity-100"
                >Article 4: Traffic Laws</a
              >
              <a
                href="#"
                class="text-bg font-body text-[13px] font-medium opacity-80 transition-opacity hover:opacity-100"
                >Article 5: Homologation</a
              >
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>
