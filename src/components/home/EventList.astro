---
import { getCollection } from 'astro:content';
import {
  getLangFromUrl,
  getLocalizedCollection,
  useTranslations,
  useTranslatedPath,
} from '../../i18n/utils';
import Icon from '../Icon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allEvents = await getCollection('events');
const localizedEvents = getLocalizedCollection(allEvents, lang);
const today = new Date();

// Load up to 12 upcoming events to demonstrate the slider
const upcomingEvents = localizedEvents
  .filter((event) => event.data.date >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 12);

function getTimeLimit(distance: number) {
  if (distance >= 1200) return '90h 00m';
  if (distance >= 1000) return '75h 00m';
  if (distance >= 600) return '40h 00m';
  if (distance >= 400) return '27h 00m';
  if (distance >= 300) return '20h 00m';
  if (distance >= 200) return '13h 30m';
  return 'N/A';
}

function formatDate(date: Date) {
  return date.toLocaleDateString(
    lang === 'be' ? 'be-BY' : lang === 'ru' ? 'ru-RU' : 'en-GB',
    {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }
  );
}
---

<section class="bg-page-bg overflow-hidden py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-16">
    <!-- Header with Sliding Arrows -->
    <div
      class="mb-12 flex flex-col justify-between gap-6 sm:flex-row sm:items-end"
    >
      <div>
        <h2
          class="font-heading text-text text-3xl font-extrabold tracking-tight uppercase md:text-5xl"
        >
          {t('home.upcoming_events')}
        </h2>
      </div>

      <div class="flex items-center gap-4 sm:gap-6">
        <a
          href={translatePath('/events')}
          class="border-accent text-accent hover:bg-accent/10 shrink-0 rounded-full border px-6 py-3 text-sm font-semibold tracking-wide uppercase transition-colors duration-200"
        >
          {t('home.view_all_events')}
        </a>

        <!-- Slider Navigation Arrows -->
        <div class="flex items-center gap-2">
          <button
            id="slide-prev"
            class="border-surface text-text hover:bg-surface flex size-12 items-center justify-center rounded-full border transition-all focus:outline-none active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
            aria-label="Previous events"
          >
            <Icon name="ChevronLeft" class="size-5" />
          </button>
          <button
            id="slide-next"
            class="border-surface text-text hover:bg-surface flex size-12 items-center justify-center rounded-full border transition-all focus:outline-none active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
            aria-label="Next events"
          >
            <Icon name="ChevronRight" class="size-5" />
          </button>
        </div>
      </div>
    </div>

    <!-- Events Slider Container -->
    <div
      id="events-slider"
      class="scrollbar-hide flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-6"
    >
      {
        upcomingEvents.map((event) => (
          <div class="w-[280px] shrink-0 snap-start sm:w-[320px] md:w-[368px]">
            <a
              href={translatePath(`/events/${event.id}`)}
              class="group bg-page-bg border-surface flex h-[460px] flex-col overflow-hidden rounded-[24px] border-2 transition-all duration-300 hover:shadow-xl"
            >
              {/* Top Flyer Container */}
              <div class="bg-surface relative h-[200px] w-full overflow-hidden">
                <img
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  src={
                    event.data.image ||
                    'https://images.unsplash.com/photo-1559166631-ef208440c75a?q=80&w=600&auto=format&fit=crop'
                  }
                  alt={event.data.name}
                />

                {/* Badges */}
                <div class="absolute top-4 right-4 left-4 z-10 flex items-center justify-between">
                  <div class="bg-brand flex items-center justify-center rounded-full px-3 py-1.5">
                    <span class="font-heading text-surface text-xs font-bold">
                      {event.data.distance} KM
                    </span>
                  </div>
                  <div class="bg-accent flex items-center justify-center rounded-full px-3 py-1.5">
                    <span class="font-heading text-surface text-xs font-bold">
                      BRM
                    </span>
                  </div>
                </div>
              </div>

              {/* Bottom Content Box */}
              <div class="flex flex-1 flex-col justify-between p-6">
                <div class="flex flex-col gap-2">
                  <span class="font-heading text-accent text-xs font-bold tracking-wider uppercase md:text-sm">
                    {formatDate(event.data.date)}
                  </span>
                  <h3 class="font-heading text-text line-clamp-2 text-xl leading-tight font-black uppercase md:text-2xl">
                    {event.data.name}
                  </h3>
                </div>

                {/* Info Rows */}
                <div class="border-surface mt-auto flex flex-col gap-2 border-t pt-4">
                  <div class="text-text-muted flex items-center gap-2">
                    <Icon
                      name="MapPin"
                      class="text-text-muted size-4 shrink-0"
                    />
                    <span class="font-body text-sm font-medium">
                      {t('home.starts_in')}:{' '}
                      {event.data.startLocation || 'Minsk'}
                    </span>
                  </div>
                  <div class="text-text-muted flex items-center gap-2">
                    <Icon
                      name="Timer"
                      class="text-text-muted size-4 shrink-0"
                    />
                    <span class="font-body text-sm font-medium">
                      Limit: {getTimeLimit(event.data.distance)}
                    </span>
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))
      }
      {
        upcomingEvents.length === 0 && (
          <div class="text-text-muted border-surface col-span-full w-full rounded-[24px] border-2 border-dashed py-16 text-center">
            No upcoming events scheduled at this moment.
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-hide {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>

<script>
  function initEventsSlider() {
    const slider = document.getElementById('events-slider');
    const prevBtn = document.getElementById(
      'slide-prev'
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      'slide-next'
    ) as HTMLButtonElement | null;

    if (slider && prevBtn && nextBtn) {
      const getScrollAmount = () => {
        const firstCard = slider.firstElementChild as HTMLElement | null;
        if (firstCard) {
          return firstCard.offsetWidth + 24; // Card width + 24px gap
        }
        return 392; // Default fallback width
      };

      prevBtn.addEventListener('click', () => {
        slider.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        slider.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });

      const updateButtonStates = () => {
        const scrollLeft = slider.scrollLeft;
        const maxScrollLeft = slider.scrollWidth - slider.clientWidth;

        const isAtStart = scrollLeft <= 5;
        const isAtEnd = scrollLeft >= maxScrollLeft - 5;

        prevBtn.disabled = isAtStart;
        nextBtn.disabled = isAtEnd;
      };

      slider.addEventListener('scroll', updateButtonStates);
      window.addEventListener('resize', updateButtonStates);

      // Run once immediately
      updateButtonStates();
      // Run again after a short delay to ensure rendering completes
      setTimeout(updateButtonStates, 200);
    }
  }

  // Support Astro View Transitions page load events
  document.addEventListener('astro:page-load', initEventsSlider);
  // Fallback for initial load
  initEventsSlider();
</script>
