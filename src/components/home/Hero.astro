---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../../i18n/utils';
import Icon from '../Icon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="bg-bg relative flex min-h-[600px] items-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1541625602330-2277a4c46182?q=80&w=2070&auto=format&fit=crop"
      alt="Cyclist"
      class="h-full w-full object-cover opacity-50"
    />
    <div
      class="from-charcoal/10 via-charcoal/60 to-charcoal absolute inset-0 bg-gradient-to-b"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto max-w-7xl px-4 text-center sm:px-8 lg:px-16"
  >
    <h1
      class="text-text-inverse mb-6 block text-3xl leading-tight font-bold tracking-tight uppercase sm:text-4xl md:text-5xl lg:text-6xl"
    >
      {t('hero.title1')}
      <span class="text-secondary">{t('hero.title2')}</span><br />
      {t('hero.title3')}
      <span class="text-secondary">{t('hero.title4')}</span>
    </h1>

    <p class="text-gray mx-auto mt-3 mb-10 max-w-2xl text-lg">
      {t('hero.subtitle')}
    </p>

    <div class="flex flex-col justify-center gap-4 sm:flex-row">
      <a
        class="bg-primary text-text-inverse inline-flex items-center justify-center gap-x-2 rounded-full border border-transparent px-6 py-3 text-sm font-semibold hover:bg-blue-700 disabled:pointer-events-none disabled:opacity-50"
        href={translatePath('/events')}
      >
        {t('hero.find_events')}
        <Icon name="ChevronRight" class="size-4 shrink-0" />
      </a>
      <a
        class="text-text-inverse inline-flex items-center justify-center gap-x-2 rounded-full border border-white px-6 py-3 text-sm font-semibold hover:bg-white/10 disabled:pointer-events-none disabled:opacity-50"
        href={translatePath('/routes')}
      >
        {t('hero.explore_routes')}
        <Icon name="ChevronRight" class="size-4 shrink-0" />
      </a>
    </div>
  </div>
</section>
