---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../../i18n/utils';
import Icon from '../Icon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section
  class="bg-bg relative flex flex-col items-center justify-center overflow-hidden rounded-b-[48px] px-4 pt-16 pb-20 sm:px-8 lg:px-16"
>
  <!-- Active Season Badge/Pill -->
  <div
    class="bg-complementary mb-12 flex max-w-full items-center gap-4 rounded-full px-6 py-2 shadow-sm"
  >
    <div class="flex items-center gap-3">
      <span class="font-heading text-brand text-sm font-bold uppercase"
        >{t('hero.season')}</span
      >
      <span
        class="bg-brand text-surface rounded-full px-3 py-1 text-[10px] font-extrabold tracking-widest uppercase"
        >{t('hero.active')}</span
      >
    </div>
    <div class="bg-brand/30 h-5 w-px"></div>
    <div class="text-brand flex items-center gap-2">
      <span class="font-body text-sm font-bold">24</span>
      <span class="font-body text-sm font-medium"
        >{t('hero.upcoming_brevets')}</span
      >
    </div>
  </div>

  <!-- Hero Content Wrap -->
  <div class="flex max-w-4xl flex-col items-center text-center">
    <h1
      class="font-heading text-text max-w-4xl text-4xl leading-none font-bold tracking-tight uppercase sm:text-5xl md:text-[72px]"
    >
      {t('hero.title1')}<br class="hidden md:inline" />
      <span class="text-accent">{t('hero.title2')}</span>
    </h1>

    <p
      class="font-body text-text-muted mt-6 mb-8 max-w-[600px] text-lg leading-relaxed font-semibold md:text-xl"
    >
      {t('hero.subtitle')}
    </p>

    <!-- Buttons -->
    <div class="flex flex-col items-center gap-4 sm:flex-row">
      <a
        href={translatePath('/events')}
        class="bg-accent hover:bg-accent/90 inline-flex h-12 items-center justify-center rounded-full px-8 py-3 text-sm font-semibold tracking-wide text-white uppercase transition-colors duration-200"
      >
        {t('hero.find_ride')}
      </a>
      <a
        href={translatePath('/routes')}
        class="text-accent border-accent hover:bg-accent/10 inline-flex h-12 items-center justify-center rounded-full border bg-transparent px-8 py-3 text-sm font-semibold tracking-wide uppercase transition-colors duration-200"
      >
        {t('hero.explore_routes')}
      </a>
    </div>
  </div>
</section>
