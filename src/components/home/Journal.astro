---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../../i18n/utils';
import Icon from '../Icon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const categories = [
  lang === 'be' ? "Інтэрв'ю" : lang === 'ru' ? 'Интервью' : 'Interviews',
  lang === 'be' ? 'Справаздачы' : lang === 'ru' ? 'Отчеты' : 'Reports',
  lang === 'be' ? 'Рыштунак' : lang === 'ru' ? 'Снаряжение' : 'Gear',
  lang === 'be' ? 'Супольнасць' : lang === 'ru' ? 'Сообщество' : 'Community',
  lang === 'be' ? 'Маршруты' : lang === 'ru' ? 'Маршруты' : 'Routes',
];

const articles = [
  {
    category:
      lang === 'be' ? 'СПРАВАЗДАЧА' : lang === 'ru' ? 'ОТЧЕТ' : 'RACE REPORT',
    title:
      lang === 'be'
        ? 'Вакол Мінска за 300 км. Клуб Ранданёры Беларусі'
        : lang === 'ru'
          ? 'Вокруг Минска за 300 км. Клуб Рандоннеры Беларуси'
          : 'Round the Minsk Trip. Belarus Randonneurs club',
    desc:
      lang === 'be'
        ? 'Падрабязны агляд нашага класічнага 300-кіламетровага заезду вакол сталіцы з выдатнымі краявідамі і дружнай кампаніяй...'
        : lang === 'ru'
          ? 'Подробный обзор нашего классического 300-километрового заезда вокруг столицы с отличными видами и донной компанией...'
          : 'A comprehensive review of our classic 300km loop around the capital, featuring stunning landscapes and a great group dynamic...',
    date: '06/08/2025',
    distance: 'Brevet 300 km',
    image:
      'https://images.unsplash.com/photo-1517649763962-0c623066013b?q=80&w=600&auto=format&fit=crop',
  },
  {
    category:
      lang === 'be'
        ? 'АГЛЯД РЫШТУНКУ'
        : lang === 'ru'
          ? 'ОБЗОР СНАРЯЖЕНИЯ'
          : 'GEAR REVIEW',
    title:
      lang === 'be'
        ? 'Тэставанне ўнутрырамнай сумкі Restrap'
        : lang === 'ru'
          ? 'Тестирование внутрирамной сумки Restrap'
          : 'Testing the Restrap Frame Bag',
    desc:
      lang === 'be'
        ? "Падрабязны аналіз таго, як унутрырамная сумка аб'ёмам 4.5 л вытрымала 14 гадзін бесперапыннага дажджу падчас брэвета на 400 км..."
        : lang === 'ru'
          ? 'Подробный анализ того, как внутрирамная сумка объемом 4.5 л выдержала 14 часов непрерывного дождя во время бревета на 400 км...'
          : 'A detailed breakdown of how the 4.5L frame bag held up during a rainy 14-hour ride in our recent 400km qualifying brevet...',
    date: '12/04/2026',
    distance: 'Brevet 400 km',
    image:
      'https://images.unsplash.com/photo-1485965120184-e220f721d03e?q=80&w=600&auto=format&fit=crop',
  },
  {
    category:
      lang === 'be' ? 'СПРАВАЗДАЧА' : lang === 'ru' ? 'ОТЧЕТ' : 'RACE REPORT',
    title:
      lang === 'be'
        ? 'Як выжыць пры начным старце'
        : lang === 'ru'
          ? 'Как выжить при ночном старте'
          : 'Surviving the Night Start',
    desc:
      lang === 'be'
        ? 'Чаму старт брэвета на 600 км у 10 гадзін вечара цалкам змяняе дынаміку заезду і як правільна спланаваць сон і святло...'
        : lang === 'ru'
          ? 'Почему старт бревета на 600 км в 10 часов вечера полностью меняет динамику заезда и как правильно спланировать сон и свет...'
          : 'Why starting a 600km brevet at 10 PM changes the entire dynamic of the ride, and how to properly budget sleep and illumination...',
    date: '28/05/2026',
    distance: 'Brevet 600 km',
    image:
      'https://images.unsplash.com/photo-1544192240-4a34feb0104c?q=80&w=600&auto=format&fit=crop',
  },
];
---

<section class="bg-bg py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-16">
    <!-- Header -->
    <div
      class="mb-12 flex flex-col justify-between gap-8 lg:flex-row lg:items-center"
    >
      <div>
        <h2
          class="font-heading text-text text-3xl font-extrabold tracking-tight uppercase md:text-5xl"
        >
          {t('home.journal_title')}
        </h2>
      </div>
      <!-- Categories Wrapper -->
      <div class="flex flex-wrap items-center gap-2 lg:justify-end">
        {
          categories.map((cat) => (
            <span class="border-surface text-text-muted hover:text-accent cursor-default rounded-full border bg-white/80 px-4 py-1.5 text-xs font-semibold shadow-sm transition-colors duration-150 select-none hover:bg-white">
              {cat}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <div class="bg-page-bg border-surface group flex h-[480px] cursor-pointer flex-col overflow-hidden rounded-[24px] border transition-all duration-300 hover:shadow-xl">
            {/* Image Header */}
            <div class="bg-surface relative h-[200px] w-full overflow-hidden">
              <img
                src={article.image}
                alt={article.title}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              {/* Category Badge */}
              <span class="bg-accent text-surface font-heading absolute top-4 left-4 z-10 rounded-full px-3 py-1.5 text-[10px] font-extrabold tracking-wider uppercase shadow-sm">
                {article.category}
              </span>
            </div>

            {/* Content Box */}
            <div class="flex flex-1 flex-col justify-between p-6">
              <div class="flex flex-col gap-3">
                <h3 class="font-heading text-text group-hover:text-accent line-clamp-2 text-lg leading-tight font-extrabold uppercase transition-colors duration-150 md:text-xl">
                  {article.title}
                </h3>
                <p class="font-body text-text-muted line-clamp-3 text-sm leading-relaxed">
                  {article.desc}
                </p>
              </div>

              {/* Meta Footer */}
              <div class="text-text-muted border-surface mt-auto flex items-center justify-between border-t pt-4 text-xs font-semibold">
                <span class="font-body">{article.date}</span>
                <span class="font-heading text-accent tracking-wider uppercase">
                  {article.distance}
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bottom Read All Button -->
    <div class="flex justify-center">
      <a
        href={translatePath('/journal')}
        class="border-accent text-accent hover:bg-accent/10 inline-flex h-12 items-center justify-center rounded-full border px-8 py-3 text-sm font-semibold tracking-wide uppercase transition-colors duration-200"
      >
        {t('home.read_all_posts')}
      </a>
    </div>
  </div>
</section>
