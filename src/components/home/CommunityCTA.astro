---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="bg-page-bg py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-16">
    <div
      class="bg-brand flex flex-col items-center justify-between gap-8 rounded-2xl p-8 shadow-md md:flex-row md:p-12"
    >
      <!-- Left Column: Title & Subtitle -->
      <div
        class="flex w-full flex-col gap-2 text-center md:max-w-xl md:text-left"
      >
        <h2
          class="font-heading text-2xl font-bold tracking-tight text-white uppercase md:text-3xl"
        >
          {t('home.still_questions')}
        </h2>
        <p
          class="font-body text-surface/90 text-sm leading-relaxed md:text-base"
        >
          {t('home.community_desc')}
        </p>
      </div>

      <!-- Right Column: Solid High-Contrast Button -->
      <div class="shrink-0">
        <a
          href="https://t.me/rbelby"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-complementary text-brand hover:bg-complementary/90 inline-flex h-12 items-center justify-center rounded-full px-8 py-3.5 text-sm font-bold tracking-wide uppercase shadow-sm transition-all duration-200"
        >
          {t('home.join_community')}
        </a>
      </div>
    </div>
  </div>
</section>
