---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="bg-brand text-bg w-full">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-16 px-4 py-10 sm:px-8 sm:py-20 lg:px-16"
  >
    <!-- Top Section -->
    <div class="flex flex-col justify-between gap-16 lg:flex-row lg:gap-8">
      <!-- Left: Logo & Social -->
      <div class="flex flex-col gap-12">
        <!-- Logo (From Navbar) -->
        <a
          class="inline-block flex-none focus:opacity-80 focus:outline-hidden"
          href={translatePath('/')}
        >
          <div class="flex items-center gap-3">
            <img
              src="/rbel-icon.png"
              alt="Randonneurs Belarus"
              width="52"
              height="40"
              class="h-10 w-[52px] object-contain"
            />
            <div
              class="font-heading text-page-bg flex h-10 flex-col justify-center pt-1 text-base leading-[1] font-black tracking-wider uppercase"
            >
              <span>Беларускія</span>
              <span>Ранданёры</span>
            </div>
          </div>
        </a>

        <!-- Social Links (Placeholder structure based on design) -->
        <div class="flex gap-6">
          <a
            href="#"
            class="font-body text-bg flex items-center gap-2 text-base font-medium transition hover:opacity-80"
          >
            <svg
              class="text-complementary h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM16.64 8.8C16.49 10.48 15.82 14.18 15.46 15.88C15.31 16.6 15.04 16.84 14.79 16.86C14.23 16.91 13.8 16.5 13.27 16.14C12.42 15.58 11.94 15.24 11.13 14.7C10.19 14.08 10.8 13.74 11.35 13.18C11.49 13.04 13.85 10.88 13.9 10.68C13.91 10.65 13.91 10.55 13.85 10.5C13.8 10.45 13.71 10.47 13.65 10.48C13.56 10.51 12.06 11.48 9.17 13.43C8.75 13.73 8.36 13.86 8.01 13.86C7.62 13.85 6.88 13.65 6.32 13.46C5.64 13.24 5.11 13.12 5.15 12.74C5.17 12.54 5.44 12.33 5.96 12.11C9.17 10.71 11.31 9.8 12.38 9.35C15.44 8.08 16.08 7.85 16.5 7.84C16.59 7.84 16.8 7.86 16.94 7.97C17.05 8.06 17.09 8.2 17.1 8.3C17.09 8.35 16.67 8.65 16.64 8.8Z"
              ></path></svg
            >
            Telegram
          </a>
          <a
            href="#"
            class="font-body text-bg flex items-center gap-2 text-base font-medium transition hover:opacity-80"
          >
            <svg
              class="text-complementary h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 7C9.23858 7 7 9.23858 7 12C7 14.7614 9.23858 17 12 17C14.7614 17 17 14.7614 17 12C17 9.23858 14.7614 7 12 7ZM9 12C9 13.6569 10.3431 15 12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12Z"
              ></path><path
                d="M18 5C17.4477 5 17 5.44772 17 6C17 6.55228 17.4477 7 18 7C18.5523 7 19 6.55228 19 6C19 5.44772 18.5523 5 18 5Z"
              ></path><path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M5 1.5C3.067 1.5 1.5 3.067 1.5 5V19C1.5 20.933 3.067 22.5 5 22.5H19C20.933 22.5 22.5 20.933 22.5 19V5C22.5 3.067 20.933 1.5 19 1.5H5ZM3.5 5C3.5 4.17157 4.17157 3.5 5 3.5H19C19.8284 3.5 20.5 4.17157 20.5 5V19C20.5 19.8284 19.8284 20.5 19 20.5H5C4.17157 20.5 3.5 19.8284 3.5 19V5Z"
              ></path></svg
            >
            Instagram
          </a>
          <a
            href="#"
            class="font-body text-bg flex items-center gap-2 text-base font-medium transition hover:opacity-80"
          >
            <svg
              class="text-complementary h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"
              ></path></svg
            >
            Strava
          </a>
        </div>
      </div>

      <!-- Right: Links Columns -->
      <div class="flex flex-col gap-12 sm:flex-row sm:gap-[120px]">
        <!-- Col 1: Platform -->
        <div class="flex flex-col gap-4">
          <h4
            class="text-complementary font-heading mb-0 text-base font-bold uppercase"
          >
            {t('footer.platform')}
          </h4>
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/events')}>{t('footer.upcoming')}</a
          >
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/routes')}>{t('footer.route_library')}</a
          >
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/stats')}>{t('footer.season_stats')}</a
          >
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/about')}>{t('footer.about')}</a
          >
        </div>

        <!-- Col 2: Community -->
        <div class="flex flex-col gap-4">
          <h4
            class="text-complementary font-heading mb-0 text-base font-bold uppercase"
          >
            {t('footer.community')}
          </h4>
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/clubs')}>{t('footer.find_club')}</a
          >
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/volunteer')}>{t('footer.volunteer')}</a
          >
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/rules')}>{t('footer.rules')}</a
          >
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/journal')}>Journal</a
          >
          <a
            class="font-body text-bg text-base transition hover:opacity-80"
            href={translatePath('/faq')}>{t('footer.faq')}</a
          >
        </div>

        <!-- Col 3: Contact Us -->
        <div class="flex flex-col gap-4">
          <h4
            class="text-complementary font-heading mb-0 text-base font-bold uppercase"
          >
            CONTACT US
          </h4>
          <span class="font-body text-bg text-base">info@rbelby.cc</span>
          <span class="font-body text-bg text-base">Minsk, Belarus</span>
        </div>
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="border-bg flex flex-col items-center justify-between gap-4 border-t pt-6 sm:flex-row"
    >
      <span class="font-body text-bg text-xs">
        © 2026 Randonneurs Belarus. All rights reserved.
      </span>
      <div class="flex gap-6">
        <a
          href={translatePath('/privacy')}
          class="font-body text-bg text-xs transition hover:opacity-80"
          >{t('footer.privacy') || 'Privacy Policy'}</a
        >
        <a
          href={translatePath('/terms')}
          class="font-body text-bg text-xs transition hover:opacity-80"
          >{t('footer.terms') || 'Terms of Service'}</a
        >
      </div>
    </div>
  </div>
</footer>
