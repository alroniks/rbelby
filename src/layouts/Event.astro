---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  event: any;
}

const { event } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const formattedDate = new Date(event.data.date).toLocaleDateString(
  lang === 'en' ? 'en-US' : lang === 'be' ? 'be-BY' : 'ru-RU',
  { year: 'numeric', month: 'long', day: 'numeric' }
);

function getTimeLimit(distance: number) {
  if (distance >= 1200) return '90h';
  if (distance >= 1000) return '75h';
  if (distance >= 600) return '40h';
  if (distance >= 400) return '27h';
  if (distance >= 300) return '20h';
  if (distance >= 200) return '13.5h';
  return 'N/A';
}
---

<Layout title={event.data.name}>
  <Navbar />
  <main class="bg-bg min-h-screen px-4 py-10 sm:px-8 lg:px-16">
    <article
      class="mx-auto max-w-4xl rounded-xl border border-gray-200 bg-white p-8 shadow-sm dark:border-neutral-700 dark:bg-neutral-800"
    >
      <header
        class="mb-8 border-b border-gray-100 pb-8 dark:border-neutral-700"
      >
        <h1
          class="text-charcoal font-heading dark:text-text mb-4 text-3xl font-bold md:text-4xl"
        >
          {event.data.name}
        </h1>

        <div class="text-text-muted flex flex-wrap gap-4 text-sm">
          <div class="flex items-center gap-1">
            <svg
              class="size-4"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
              ></path>
            </svg>
            {formattedDate}
          </div>
          <div class="flex items-center gap-1">
            <svg
              class="size-4"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
              ></path>
            </svg>
            {event.data.distance} km ({getTimeLimit(event.data.distance)})
          </div>
          {
            event.data.startLocation && (
              <div class="flex items-center gap-1">
                <svg
                  class="size-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                  />
                </svg>
                {event.data.startLocation}
              </div>
            )
          }
        </div>
      </header>

      <div
        class="prose prose-lg dark:prose-invert prose-a:text-primary hover:prose-a:text-secondary max-w-none"
      >
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Layout>
