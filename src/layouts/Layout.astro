---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ClientRouter } from 'astro:transitions';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <ClientRouter />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Overpass:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/rbel-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{t('title')}</title>
    <meta name="description" content={t('description')} />

    <script is:inline>
      function applyTheme(theme) {
        let resolvedTheme = theme;
        if (theme === 'system') {
          resolvedTheme = window.matchMedia('(prefers-color-scheme: dark)')
            .matches
            ? 'dark'
            : 'light';
        }

        if (resolvedTheme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
        document.documentElement.setAttribute('data-theme', resolvedTheme);
      }

      const savedTheme =
        typeof localStorage !== 'undefined' && localStorage.getItem('theme')
          ? localStorage.getItem('theme')
          : 'system';
      applyTheme(savedTheme);

      if (typeof window !== 'undefined') {
        window.applyTheme = applyTheme;
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', () => {
            if (!localStorage.getItem('theme')) {
              applyTheme('system');
            }
          });
      }
    </script>

    <!-- Analytics -->
    <script
      defer
      src="https://atmetrics.netlify.app/script.js"
      data-website-id="811ecd8e-a38c-4aaa-935a-ddf29bbadb12"></script>
  </head>
  <body>
    <slot />
  </body><!-- Preline UI & Dynamic Re-initialization for Astro View Transitions -->
  <script is:inline src="/node_modules/preline/dist/index.js"></script>
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      window.HSStaticMethods?.autoInit();
    });
  </script>
</html>
