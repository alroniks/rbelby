                              "type": "text",
                              "id": "zFUgt",
                              "fill": "$color-text",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Host social \"no-drop\" rides and introductory workshops for riders new to ultra-distance cycling.",
                              "lineHeight": 1.6,
                              "fontFamily": "Montserrat",
