            80,
            64
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "yfeCR",
              "name": "vision",
              "width": 1000,
              "layout": "vertical",
              "gap": 32,
              "children": [
                {
                  "type": "text",
                  "id": "ekwKc",
                  "fill": "$color-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "IT'S NOT JUST ABOUT THE DISTANCE. IT'S ABOUT DISCOVERING OUR COUNTRY, THE PEOPLE, AND THE RELENTLESS WILL TO KEEP PEDALING.",
                  "lineHeight": 1.1,
                  "fontFamily": "Overpass",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "FCQYp",
                  "fill": "$color-text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Since our official inception in 2010, the randonneuring community in Belarus has grown from a handful of enthusiasts testing their limits into a nationwide movement. We brought the rich French tradition of Audax Club Parisien to the sprawling, diverse landscapes of our homeland, uniting riders under a shared passion for ultra-endurance.",
                  "lineHeight": 1.6,
                  "fontFamily": "Montserrat",
                  "fontSize": 20,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "aegUh",
              "name": "facts",
              "width": 1000,
              "height": 240,
              "gap": 24,
              "children": [
                {
                  "type": "frame",
                  "id": "QFIBc",
