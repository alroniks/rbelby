                }
              ]
            },
            {
              "type": "frame",
              "id": "i3hgT",
              "name": "history",
              "width": 1000,
              "gap": 64,
              "children": [
                {
                  "type": "frame",
                  "id": "J6k3N",
                  "name": "hLeft",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 32,
                  "children": [
                    {
                      "type": "text",
                      "id": "u2ikws",
                      "fill": "$color-text",
                      "content": "HOW IT ALL STARTED",
                      "fontFamily": "Overpass",
                      "fontSize": 32,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "cxZFi",
                      "fill": "$color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Before GPS head units, smartwatches, and ultra-light bikepacking gear became common, completing a 200km brevet required a paper cue sheet, an unwavering sense of direction, and immense grit. Our first official brevet saw a tiny group of riders battling headwinds and rough gravel roads. It wasn't about speed; it was about survival, camaraderie, and proving that it could be done.",
                      "lineHeight": 1.6,
                      "fontFamily": "Montserrat",
                      "fontSize": 16,
                      "fontWeight": "normal"
