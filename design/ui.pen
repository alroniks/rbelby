          "children": [
            {
              "type": "frame",
              "id": "CQOLp",
              "name": "artHeroImg",
              "width": 1000,
              "height": 500,
              "fill": {
                "type": "image",
                "enabled": true,
                "url": "images/generated-1778453387076.png",
                "mode": "fill"
              },
              "cornerRadius": [
                0,
                80,
                0,
                0
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "WB1Uy",
          "name": "artBody",
          "width": "fill_container",
          "layout": "vertical",
          "padding": [
            0,
            64,
            80,
            64
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "fqHvY",
              "name": "artContent",
              "width": 800,
              "layout": "vertical",
              "gap": 32,
              "children": [
                {
                  "type": "text",
                  "id": "y9bqhJ",
                  "fill": "$color-text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When the weather turns sour halfway through a Super Randonneur series, your equipment choices matter more than ever. I learned this the hard way during my first 600km qualifier. The forecast called for light showers; reality delivered a torrential downpour that lasted for 14 straight hours.",
                  "lineHeight": 1.6,
                  "fontFamily": "Montserrat",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "VwWcq",
                  "fill": "$color-text",
                  "content": "The Right Jacket",
                  "fontFamily": "Overpass",
                  "fontSize": 32,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "M2LMTy",
                  "fill": "$color-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A good rain jacket is the cornerstone of your wet-weather kit. It needs to strike the impossible balance between waterproofing and breathability. Gore-Tex Shakedry was the gold standard, but newer alternatives are closing the gap.",
                  "lineHeight": 1.6,
                  "fontFamily": "Montserrat",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "uYEMh",
                  "name": "screamer",
                  "width": "fill_container",
                  "fill": "$color-surface",
                  "cornerRadius": 12,
                  "stroke": "$color-text-muted",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "gap": 24,
                  "padding": 32,
                  "children": [
                    {
                      "type": "text",
                      "id": "fM5Q9",
                      "content": "💡",
                      "fontFamily": "Montserrat",
                      "fontSize": 24,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "W2B9Do",
                      "fill": "$color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "PRO TIP: Always pack your rain gear in a waterproof dry bag inside your saddlebag. A wet jacket at the start of a cold night is a recipe for hypothermia.",
                      "lineHeight": 1.5,
                      "fontFamily": "Montserrat",
                      "fontSize": 18,
                      "fontWeight": "600"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "ejAPH",
                  "fill": "$color-text",
                  "content": "Layering strategy",
                  "fontFamily": "Overpass",
                  "fontSize": 32,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "ZUh3N",
                  "fill": "$color-text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Merino wool base layers retain their insulating properties even when wet. Combine this with a thermal mid-layer and your rain shell, and you create a micro-climate that will sustain you through the coldest descents.",
                  "lineHeight": 1.6,
                  "fontFamily": "Montserrat",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "R38KJA",
                  "name": "quote",
                  "width": "fill_container",
