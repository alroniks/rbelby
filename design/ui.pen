                            },
                            {
                              "type": "text",
                              "id": "e5oqNg",
                              "fill": "$color-text",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Organize official ACP-sanctioned brevets ranging from 200km to 1000km across diverse terrains.",
                              "lineHeight": 1.6,
                              "fontFamily": "Montserrat",
