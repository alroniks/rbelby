            }
          ]
        },
        {
          "type": "frame",
          "id": "ZvVJ0",
          "name": "mHeroImg",
          "width": "fill_container",
          "height": 260,
          "fill": {
            "type": "image",
            "enabled": true,
            "url": "images/generated-1778453387076.png",
            "mode": "fill"
          },
          "cornerRadius": [
            0,
            48,
            0,
            0
          ]
        },
        {
          "type": "frame",
          "id": "hAWGr",
          "name": "mBody",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 24,
          "padding": [
            32,
            24,
            64,
            24
          ],
          "children": [
            {
              "type": "text",
              "id": "ZA0ys",
              "fill": "$color-text-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "When the weather turns sour halfway through a Super Randonneur series, your equipment choices matter more than ever. I learned this the hard way during my first 600km qualifier. The forecast called for light showers; reality delivered a torrential downpour that lasted for 14 straight hours.",
              "lineHeight": 1.6,
              "fontFamily": "Montserrat",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "l0kFA",
              "fill": "$color-text",
              "content": "The Right Jacket",
              "fontFamily": "Overpass",
              "fontSize": 24,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "fMHAu",
              "fill": "$color-text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A good rain jacket is the cornerstone of your wet-weather kit. It needs to strike the impossible balance between waterproofing and breathability. Gore-Tex Shakedry was the gold standard, but newer alternatives are closing the gap.",
              "lineHeight": 1.6,
              "fontFamily": "Montserrat",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "lBbS8",
              "width": "fill_container",
              "fill": "$color-surface",
              "cornerRadius": 12,
              "stroke": "$color-text-muted",
              "strokeWidth": 1,
              "strokeAlignment": "inner",
              "layout": "vertical",
              "gap": 16,
              "padding": 24,
              "children": [
                {
                  "type": "frame",
                  "id": "S0QaL",
                  "gap": 12,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "Xvzug",
                      "width": 20,
                      "height": 20,
                      "icon": "info",
                      "library": "lucide",
                      "fill": "$color-brand"
                    },
                    {
                      "type": "text",
                      "id": "XCTcf",
                      "fill": "$color-brand",
                      "content": "PRO TIP",
                      "fontFamily": "Overpass",
                      "fontSize": 16,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "d3nlUV",
                  "fill": "$color-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Avoid packing your rain jacket at the very bottom of your saddlebag. The weather can change in minutes, and stopping to repack everything in the rain is miserable.",
                  "lineHeight": 1.5,
                  "fontFamily": "Montserrat",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "text",
              "id": "sOMjT",
              "fill": "$color-text",
              "content": "Layering strategy",
              "fontFamily": "Overpass",
              "fontSize": 24,
              "fontWeight": "700"
            },
