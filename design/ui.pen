                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 32,
                  "children": [
                    {
                      "type": "text",
                      "id": "CFUBF",
                      "fill": "$color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Our History & Heritage",
                      "fontFamily": "Overpass",
                      "fontSize": 32,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "acO7o",
                      "fill": "$color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Minsk Randonneurs is dedicated to the spirit of Audax Club Parisien. We emphasize self-reliance, camaraderie, and the pure joy of ultra-endurance cycling. What began with a handful of enthusiasts has grown into a nationwide movement, bringing the rich French tradition of long-distance cycling to the sprawling, beautiful roads of our homeland.",
                      "lineHeight": 1.6,
                      "fontFamily": "Montserrat",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "vcNRT",
                      "fill": "$color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What We Do",
                      "fontFamily": "Overpass",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
