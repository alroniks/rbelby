                      "type": "text",
                      "id": "MAQ5w",
                      "fill": "$color-accent",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"We didn't ride to win. We rode to prove that the human body can outlast the setting sun.\"",
                      "lineHeight": 1.3,
                      "fontFamily": "Overpass",
                      "fontSize": 20,
                      "fontWeight": "600",
                      "fontStyle": "italic"
