                                  "descendants": {
                                    "F3RW8": {
                                      "content": "HOW A FLÈCHE WORKS"
                                    },
                                    "G4cqoo": {
                                      "content": "Not a fixed route: each team designs its own and rides it together."
                                    },
                                    "s2iYNg": {
                                      "content": "Form a team"
                                    },
                                    "d1EP8": {
                                      "content": "3 to 5 riders. The captain registers the team on Brevly and invites the others."
                                    },
                                    "oRrSj": {
                                      "content": "Submit your route"
                                    },
                                    "PsX0k": {
                                      "content": "360 km or more in 24 h, with your own controls. The club approves it by Dec 20."
                                    },
                                    "AQs9u": {
                                      "content": "Ride together"
                                    },
                                    "N0zzGM": {
                                      "content": "The team stays together and checks in at its own controls along the way."
                                    },
                                    "X5mUM": {
                                      "content": "Finish in Minsk"
                                    },
                                    "hQkTh": {
                                      "content": "Arrive at Nemiga between 07:00 and 08:00 on Jan 3. At least 3 riders must finish."
                                    }
                                  }
