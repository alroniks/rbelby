                              "width": "fill_container",
                              "content": "Rules & limits",
                              "lineHeight": 1.2,
                              "fontFamily": "$font-heading",
                              "fontSize": 28,
                              "fontWeight": "900"
                            },
                            {
                              "type": "text",
                              "id": "OwFac",
                              "name": "H3",
                              "fill": "$text-white",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "What if I miss the time limit?",
                              "lineHeight": 1.3,
                              "fontFamily": "$font-heading",
                              "fontSize": 19,
                              "fontWeight": "800"
                            },
                            {
                              "type": "text",
                              "id": "WSVbZ",
                              "name": "Paragraph",
                              "fill": "$text-zinc-300",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "You can still finish, but the ride won't be homologated. The limit is the only clock that matters.",
                              "lineHeight": 1.75,
                              "fontFamily": "$font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "Pev7g",
                              "name": "H3",
                              "fill": "$text-white",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Can I leave the route?",
                              "lineHeight": 1.3,
                              "fontFamily": "$font-heading",
                              "fontSize": 19,
                              "fontWeight": "800"
                            },
                            {
                              "type": "text",
