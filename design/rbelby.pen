                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A spare tube, pump and tools, food and water between controls, a rain layer and a phone with the route.",
                              "lineHeight": 1.75,
                              "fontFamily": "$font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "BuOMY",
                              "name": "H2",
                              "fill": "$text-white",
