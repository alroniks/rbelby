                          "gap": 22,
                          "children": [
                            {
                              "type": "text",
                              "id": "C6HxE",
                              "name": "Lead",
                              "fill": "$text-white",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "It's not just about the distance. It's about discovering our country, its people, and the stubborn will to keep pedalling.",
                              "lineHeight": 1.75,
                              "fontFamily": "$font-sans",
                              "fontSize": 20,
                              "fontWeight": "500"
                            },
                            {
                              "type": "text",
                              "id": "T34Ytd",
                              "name": "H2",
                              "fill": "$text-white",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How it started",
                              "lineHeight": 1.2,
                              "fontFamily": "$font-heading",
                              "fontSize": 28,
                              "fontWeight": "900"
                            },
                            {
                              "type": "text",
                              "id": "a1dnB",
                              "name": "Paragraph",
                              "fill": "$text-zinc-300",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Before GPS units and ultralight bags, a 200 km brevet meant a paper cue sheet, a stamp card and a lot of trust in the road. A handful of riders from Minsk rode the first official Belarusian brevet in 2010. Today six clubs run more than forty events a season.",
                              "lineHeight": 1.75,
                              "fontFamily": "$font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "wP6lS",
                              "name": "Blockquote",
                              "width": "fill_container",
                              "stroke": "$ink",
