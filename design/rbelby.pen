                                "left": 4
                              },
                              "strokeAlignment": "inner",
                              "padding": [
                                4,
                                0,
                                4,
                                22
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "DeQwH",
                                  "name": "Text",
                                  "fill": "$ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We didn't ride to win. We rode to prove the body can outlast the setting sun.",
                                  "lineHeight": 1.4,
                                  "fontFamily": "$font-heading",
                                  "fontSize": 22,
                                  "fontWeight": "800"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "UlsrT",
                              "name": "H2",
                              "fill": "$text-white",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "The spirit of randonneuring",
