                    {
                      "type": "frame",
                      "id": "dk4Vc",
                      "name": "Markdown · sample",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 22,
                      "children": [
                        {
                          "type": "text",
                          "id": "KSnFc",
                          "name": "Lead",
                          "fill": "$text-white",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "A brevet is a ride of 200, 300, 400, 600, 1000 or 1200 km on a set route, within a time limit. Riders check in at controls along the way, and every finish is recorded by Audax Club Parisien in France — the home of randonneuring since 1921.",
                          "lineHeight": 1.75,
                          "fontFamily": "$font-sans",
                          "fontSize": 20,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "iIcW2",
                          "name": "H2",
                          "fill": "$text-white",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Not a race",
                          "lineHeight": 1.2,
                          "fontFamily": "$font-heading",
                          "fontSize": 28,
                          "fontWeight": "900"
                        },
                        {
                          "type": "text",
                          "id": "w4fnZ1",
                          "name": "Paragraph",
                          "fill": "$text-zinc-300",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "There are no winners and no places. You ride at your own pace, alone or with others, and everyone who finishes inside the limit gets the same result. The fastest rider and the last finisher are both randonneurs.",
                          "lineHeight": 1.75,
                          "fontFamily": "$font-sans",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "TDM2h",
                          "name": "Callout",
                          "width": "fill_container",
                          "fill": "$bg-zinc-700",
                          "cornerRadius": "$radius-m",
                          "gap": 14,
                          "padding": 18,
                          "children": [
                            {
                              "type": "icon",
                              "id": "KemiO",
                              "name": "Icon",
                              "width": 19,
                              "height": 19,
                              "icon": "lightbulb",
                              "library": "lucide",
                              "fill": "$yellow-400"
                            },
