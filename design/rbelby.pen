  "children": [
    {
      "type": "frame",
      "id": "iexz1",
      "x": 0,
      "y": 0,
      "name": "rbel.by · Public Site",
      "theme": {
        "mode": "light"
      },
      "fill": "$canvas-board",
      "layout": "vertical",
      "gap": 96,
      "padding": 120,
      "children": [
        {
          "type": "frame",
          "id": "W9VRd",
          "name": "Header",
          "layout": "vertical",
          "gap": 20,
          "children": [
            {
              "type": "text",
              "id": "DoIGr",
              "name": "Eyebrow",
              "fill": "$yellow-400",
              "content": "REGION SITE · rbel.by — EXTERNAL PUBLIC HOME (ADR-0013)",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600",
              "letterSpacing": 2
            },
            {
              "type": "text",
              "id": "ADEvk",
              "name": "Title",
              "fill": "$text-white",
              "content": "rbel.by · Public Site",
              "fontFamily": "$font-sans",
              "fontSize": 96,
              "fontWeight": "700",
              "letterSpacing": -2
            },
            {
              "type": "text",
              "id": "MFNYQ",
              "name": "Lead",
              "fill": "$text-zinc-400",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "The Belarusian region's own site on rbel.by. It reads Brevly's public read API (spec 0059) for the calendar, events, results, clubs and riders, and adds region content: journal, Learn pages, search. Built from Brevly's public blocks re-skinned through the brand theme axis (brand: rbelby) plus region-only blocks. Registration and every account action live on brevly.app. Light mode only for now; desktop first.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 22,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "tTpCp",
              "name": "Meta",
              "gap": 12,
              "children": [
                {
                  "type": "frame",
                  "id": "y7aTjd",
                  "name": "Meta Route",
                  "fill": "$bg-zinc-800",
                  "cornerRadius": "$radius-pill",
                  "stroke": "$bg-zinc-600",
                  "strokeWidth": 1,
                  "gap": 8,
                  "padding": [
                    8,
                    14
                  ],
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "Jo0DN",
                      "name": "Key",
                      "fill": "$text-zinc-500",
                      "content": "ROUTE",
                      "fontFamily": "$font-sans",
                      "fontSize": 11,
                      "fontWeight": "600",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "iYnYV",
                      "name": "Val",
                      "fill": "$text-white",
                      "content": "/ · /calendar · /calendar/map · /events/{id} · /events/{id}/results · /clubs · /clubs/{id} · /riders/{id} · /results/{id} · /journal · /journal/{slug} · /learn · /learn/{slug} · /search",
                      "fontFamily": "$font-sans",
                      "fontSize": 14,
                      "fontWeight": "600"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "m1DSAm",
                  "name": "Meta Audience",
                  "fill": "$bg-zinc-800",
                  "cornerRadius": "$radius-pill",
                  "stroke": "$bg-zinc-600",
                  "strokeWidth": 1,
                  "gap": 8,
                  "padding": [
                    8,
                    14
                  ],
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "emYVp",
                      "name": "Key",
                      "fill": "$text-zinc-500",
                      "content": "SOURCES",
                      "fontFamily": "$font-sans",
                      "fontSize": 11,
                      "fontWeight": "600",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "laJtZ",
                      "name": "Val",
                      "fill": "$text-white",
                      "content": "rbelby.pen + brevly 01 · Public Pages · specs 0058 / 0059",
                      "fontFamily": "$font-sans",
                      "fontSize": 14,
                      "fontWeight": "600"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "eB31K",
                  "name": "Meta Branding",
                  "fill": "$bg-zinc-800",
                  "cornerRadius": "$radius-pill",
                  "stroke": "$bg-zinc-600",
                  "strokeWidth": 1,
                  "gap": 8,
                  "padding": [
                    8,
                    14
                  ],
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "J5Mgpa",
                      "name": "Key",
                      "fill": "$text-zinc-500",
                      "content": "BRAND",
                      "fontFamily": "$font-sans",
                      "fontSize": 11,
                      "fontWeight": "600",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "L9jKI",
                      "name": "Val",
                      "fill": "$text-white",
                      "content": "Forked from brevly.pen 2026-10-30 · Powered by Brevly",
                      "fontFamily": "$font-sans",
                      "fontSize": 14,
                      "fontWeight": "600"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "M4N0w",
          "name": "Blocks · Common",
          "width": 3600,
          "layout": "vertical",
          "gap": 40,
          "children": [
            {
              "type": "frame",
              "id": "QcgWB",
              "name": "Group Header",
              "width": "fill_container",
              "stroke": "$bg-zinc-600",
              "strokeWidth": {
                "bottom": 1
              },
              "layout": "vertical",
              "gap": 8,
              "padding": [
