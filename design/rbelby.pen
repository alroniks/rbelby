                              "type": "text",
                              "id": "UfOF9",
                              "name": "Text",
                              "fill": "$text-white",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Self-sufficiency is the golden rule: no support cars between controls. Carry what you need, or buy it on the way.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-sans",
                              "fontSize": 15,
                              "fontWeight": "600"
