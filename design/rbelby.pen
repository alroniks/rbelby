                              "name": "Paragraph",
                              "fill": "$text-zinc-300",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Yes, for food or sleep — come back to the exact point where you left it.",
                              "lineHeight": 1.75,
                              "fontFamily": "$font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
